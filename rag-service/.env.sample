# Chat-generation provider: 'gemini' (Google, fast) or 'ollama' (local).
# Embeddings + retrieval always stay on local Ollama, so switching this never
# requires re-embedding the Chroma store.
AI_PROVIDER=ollama
GEMINI_API_KEY=
# GEMINI_API_KEYS= (optional, comma-separated extra keys for rotation)
GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3-flash-preview,gemini-flash-latest,gemini-2.0-flash

# Ollama (local; no API key). Same server BOT + VIntuna use.
OLLAMA_BASE_URL=http://localhost:11434
RAG_EMBED_MODEL=bge-m3
RAG_CHAT_MODEL=llama3.1:8b

# Retrieval / chunking (BOT defaults)
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_RETRIEVE_K=4

# Relevance floor for the support "only answer if we know" gate (0..1).
# Embedder-specific AND size-specific: every model has its own score
# distribution, and the more chunks a store holds the more likely an off-topic
# query finds something. Re-calibrate whenever either changes, by scoring
# on-topic vs off-topic queries and picking a value in the gap — using messy
# real phrasing (typos, shorthand), not polished test queries, which score far
# higher and lead to a floor that silently refuses genuine questions.
RAG_MIN_SCORE=0.55

RAG_COLLECTION=shakti
